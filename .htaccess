# Proteção LGPD e Segurança (Apache / XAMPP)
Options -Indexes

<FilesMatch "\.(csv|xlsx|xls|env|local|py|bat|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^(\.env.*|\.git.*|data\.js|ga4-credentials\.json|.*_cache\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
